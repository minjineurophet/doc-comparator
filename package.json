{
  "name": "doc-comparator",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "docling": "docling_service/.venv/bin/uvicorn docling_service.server:app --port 8080 --reload",
    "dev:full": "concurrently -n docling,next -c cyan,green \"npm run docling\" \"npm run dev\"",
    "onlyoffice:start": "docker compose -f docker-compose.onlyoffice.yml up -d",
    "onlyoffice:stop": "docker compose -f docker-compose.onlyoffice.yml down",
    "postinstall": "node scripts/postinstall.cjs",
    "electron:dev": "electron .",
    "electron:build": "node scripts/build-electron.cjs",
    "electron:pack": "node scripts/build-electron.cjs --dir"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "docx": "^9.6.1",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5",
    "pdfjs-dist": "5.4.296",
    "sanitize-html": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "concurrently": "^9.2.1",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "tailwindcss": "^4"
  },
  "build": {
    "appId": "com.minjineurophet.doc-comparator",
    "productName": "Doc Comparator",
    "copyright": "Copyright © 2025",
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next-server",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["universal"] }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  }
}
